# ============================================================
# Chat With Your PDF - Environment Variables (EXAMPLE FILE)
# ============================================================
#
# This is a TEMPLATE. It is safe to share and safe to commit.
# It must NEVER contain a real API key.
#
# HOW TO USE:
#   1. Make a copy of this file and name it ".env"
#        cp .env.example .env
#   2. Open ".env" and paste your real key after the "=" sign
#   3. Never share, screenshot, or commit your ".env" file
#
# The real ".env" file is excluded by .gitignore.
# ------------------------------------------------------------

# Your Google Gemini API key.
# Get a free one at: https://aistudio.google.com/apikey
# Leave this blank here - fill it in only inside your own .env
GEMINI_API_KEY=
